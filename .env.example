# URL of the json-server backend, baked into the build by Vite.
#
# Docker/Portainer: leave this unset — the Dockerfile defaults VITE_API_URL
# to "/api", which nginx reverse-proxies to the worldwise-api container.
#
# Local dev (npm run dev): unset is fine, it falls back to http://localhost:4000
# (run the backend with `npm run server`).
VITE_API_URL=
